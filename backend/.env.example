# ==============================================================================
# WIRA SATYA 96 - BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to .env and replace placeholder values before running.
# ==============================================================================
PORT=5000
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_key_here

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here
DB_NAME=wirasatya96

# MinIO S3 Object Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_PUBLIC_URL=http://localhost:9000

# MinIO Buckets
BUCKET_AVATARS=wirasatya-avatars
BUCKET_POSTS=wirasatya-posts
BUCKET_DOCUMENTS=wirasatya-documents
