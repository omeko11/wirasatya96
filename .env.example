# ==============================================================================
# SISTEM INFORMASI BATALYON WIRA SATYA AKPOL 1996 - ENVIRONMENT TEMPLATE
# [ID] Salin berkas ini menjadi .env (lokal) dan sesuaikan nilainya:
# [EN] Copy this file to .env (local) and configure your secret values:
#      cp .env.example .env
#
# PERINGATAN / WARNING:
# Jangan pernah meng-commit berkas .env yang berisi kredensial asli ke GitHub!
# Never commit actual .env files or production secrets to public repositories!
# ==============================================================================

# 1. Frontend & API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# 2. Cloud Persistence (Supabase Multi-Table Sync - Optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_jwt_secret_key

# 4. PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_your_database_password
DB_NAME=wirasatya96

# 5. MinIO S3 Object Storage Connection
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=replace_with_your_minio_access_key
MINIO_SECRET_KEY=replace_with_your_minio_secret_key
BUCKET_AVATARS=wirasatya-avatars
BUCKET_POSTS=wirasatya-posts
BUCKET_DOCUMENTS=wirasatya-documents
