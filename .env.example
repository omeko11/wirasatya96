# ==============================================================================
# SISTEM INFORMASI BATALYON WIRA SATYA AKPOL 1996 - ENVIRONMENT TEMPLATE
# Salin file ini menjadi .env (lokal) dan sesuaikan nilainya:
#   cp .env.example .env
# PERINGATAN: JANGAN PERNAH MENG-COMMIT FILE .env BERISI KATA SANDI KE GITHUB!
# ==============================================================================

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=ganti_dengan_kunci_jwt_rahasia_dan_panjang_anda

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_database_anda
DB_NAME=wirasatya96

# MinIO Object Storage Connection (S3 Protocol)
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=ganti_dengan_minio_access_key
MINIO_SECRET_KEY=ganti_dengan_minio_secret_key
BUCKET_AVATARS=wirasatya-avatars
BUCKET_POSTS=wirasatya-posts
BUCKET_DOCUMENTS=wirasatya-documents
