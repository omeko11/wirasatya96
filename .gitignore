# ==============================================================================
# SISTEM INFORMASI BATALYON WIRA SATYA AKPOL 1996 - .gitignore
# Standardized for Next.js 14 + Node.js/Express + PostgreSQL + MinIO + Docker
# ==============================================================================

# Dependencies
node_modules/
backend/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Outputs
.next/
out/
build/
backend/dist/
backend/build/

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Environment Variables & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
*.pem
*.key
*.cert

# Vercel Deployment Metadata
.vercel

# TypeScript Outputs
*.tsbuildinfo
next-env.d.ts

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Docker & Local Data Persistence (Keep directory structures via .gitkeep)
/data_aplikasi/postgres/*
!/data_aplikasi/postgres/.gitkeep
/data_aplikasi/minio/*
!/data_aplikasi/minio/.gitkeep
/data_aplikasi/backups/*
!/data_aplikasi/backups/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
